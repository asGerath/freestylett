NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_local_or_hosted_publishable_key

# Docker only: server-side requests use this address to reach Supabase on the host.
# Leave it unset when running Next.js directly on the host.
# SUPABASE_INTERNAL_URL=http://host.docker.internal:54321
